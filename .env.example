# Harness Agent — environment variables template.
#
# Copy to .env, fill in the real values, and never commit the .env
# file. The Dockerfile and .dockerignore both refuse to bake .env
# into the image; the platform / docker-compose injects it at run
# time via env_file.
#
# Production note: API keys and admin credentials should be set
# through the platform's "环境变量" panel rather than baked into
# .env in the repo. .env.example is purely a documentation file
# listing what the application reads.

# ---- LLM provider (required for chat / KB Q&A) ---------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ---- Server runtime ------------------------------------------------
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# ---- Login / admin (enable in production) --------------------------
# Leaving AUTH_PASSWORD empty disables the login flow. When deploying
# externally, set both values via the platform — do NOT commit secrets.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# ---- Optional: realtime search providers ---------------------------
# Leave empty to use the no-key DuckDuckGo fallback.
SEARCH_PROVIDER=
DASHSCOPE_API_KEY=
SEARCH_TOOL_NAME=auto
SEARCH_API_BASE=

# ---- Optional: side-channel Scout / Optimizer LLM enrichment -------
EVOLUTION_LLM_ENABLED=

# ---- Legacy CLI / agent_harness (optional) -------------------------
MODEL_ID=
